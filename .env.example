# LLM Configuration (vendor-neutral, OpenAI-compatible)
# Point LLM_BASE_URL at any OpenAI-compatible /v1/chat/completions endpoint.
#   OpenAI:         https://api.openai.com/v1
#   Ollama (local): http://localhost:11434/v1
#   vLLM / Groq / DeepSeek / OpenRouter / LM Studio: their /v1 base URL
# Legacy OPENAI_* variables are still accepted for backward compatibility.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# Free local alternative (no API key needed — install Ollama + pull a model first):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_TIMEOUT=120

# FinMind Configuration (optional)
# Only needed for monthly-revenue charts, which require a paid FinMind tier.
# Price / K-line / PE charts use free TWSE data and need no token.
FINMIND_API_TOKEN=your_finmind_api_token_here
FINMIND_BASE_URL=https://api.finmindtrade.com/api/v4

# Application Configuration
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO